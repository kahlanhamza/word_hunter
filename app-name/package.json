{
  "name": "app-name",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=25.0.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/game/*.test.ts src/services/*.test.ts",
    "test:scaffold": "tsx --test scripts/scaffold.test.ts",
    "check:dependencies": "expo install --check",
    "assets:embed": "node scripts/embed-artwork.mjs",
    "assets:icon": "node scripts/generate-icon.mjs",
    "assets:generate": "node scripts/embed-artwork.mjs && node scripts/generate-icon.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.22",
    "expo-asset": "57.0.17",
    "expo-audio": "57.0.5",
    "expo-constants": "57.0.18",
    "expo-dev-client": "57.0.19",
    "expo-font": "57.0.4",
    "expo-linear-gradient": "57.0.2",
    "expo-linking": "57.0.10",
    "expo-router": "57.0.21",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-google-mobile-ads": "16.5.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@react-native/metro-config": "0.86.3",
    "@types/node": "22.19.0",
    "@types/react": "19.2.4",
    "babel-preset-expo": "57.0.11",
    "sharp": "0.35.4",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
