# Development defaults only. No backend, account, or network API is needed to play.
APP_VARIANT=development
APP_NAME="App Name (Dev)"
PACKAGE_ID=com.example.appname

# Native AdMob APP IDs use ~, not /. The plugin writes Android APPLICATION_ID.
# These are Google's official sample app IDs, never production values.
ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
ADMOB_IOS_APP_ID=ca-app-pub-3940256099942544~1458002511

# The existing ads service uses Google's platform TestIds automatically in __DEV__.
# Preview/release builds disable ad slots with missing or Google test unit IDs.
# Production requires both real unit IDs for the target platform; unit IDs use /.
EXPO_PUBLIC_INTERSTITIAL_AD_ID=
EXPO_PUBLIC_REWARDED_AD_ID=

# EAS production sets APP_VARIANT=production and rejects unset/placeholders above.
# Provide APP_NAME, PACKAGE_ID, ADMOB_ANDROID_APP_ID and both EXPO_PUBLIC_* IDs
# in the EAS production environment. ADMOB_IOS_APP_ID is additionally required
# when EAS_BUILD_PLATFORM=ios. Public unit IDs are bundled, not secrets.
# Do not put APP_VARIANT=production in the general .env used for a web preview.
